{
  "buildCommand": "npm run build",
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/family", "destination": "/index.html" },
    { "source": "/nguyen-anh-thu", "destination": "/index.html" },
    { "source": "/anh-nguyen", "destination": "/index.html" },
    { "source": "/thanh-ngan", "destination": "/index.html" },
    { "source": "/thanh-tran", "destination": "/index.html" },
    { "source": "/hoang-khuong", "destination": "/index.html" },
    { "source": "/to-nhu", "destination": "/index.html" },
    { "source": "/long-nhi", "destination": "/index.html" },
    { "source": "/kim-huong", "destination": "/index.html" },
    { "source": "/thuy-kieu", "destination": "/index.html" },
    { "source": "/nhu-y", "destination": "/index.html" },
    { "source": "/son-phi", "destination": "/index.html" },
    { "source": "/tan-tai", "destination": "/index.html" },
    { "source": "/anh-thu", "destination": "/index.html" },
    { "source": "/hien-le", "destination": "/index.html" },
    { "source": "/phuc-uyen", "destination": "/index.html" },
    { "source": "/khanh-duy", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Accept-Ranges",
          "value": "none"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
